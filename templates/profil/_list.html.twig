{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}

{% set isManager = is_granted('ROLE_MANAGER') %}
{% set isAdmin = is_granted('ROLE_ADMIN') %}

<div id="form-container"></div>
<div class="card mb-3" id="block-user-list">
    <div class="card-header">
        <div class="flex-grow-1">
            <small class="float-end text-navy">
                <div class="card-actions float-end">
                    {% if isManager or isAdmin %}
                        <div class="dropdown position-relative">
                        <a href="#" style="color:black;" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" class="">
                            {% include 'components/feather_icons/more-horizontal.html.twig' %}
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a class="dropdown-item" id="btn-add-user">
                                <i class="fas fa-plus" style="color: #4169E1;"></i>
                                {{ 'create'|trans }}
                            </a>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </small>
            <h5 class="card-title mb-0">
                <h5 class="card-title mb-0">{{ 'users'|trans }}</h5>
            </h5>
        </div>
    </div>

    <div class="card-body">
        <input type="text" id="user-search" placeholder={{ 'Search'|trans }} class="form-control mb-3">
        <div id="user-list">
            <div class="table-responsive">
                <table class="table table-bordered border-primary table-hover table-striped">
                    <thead class="table-primary">
                        <tr>
                            <th>{{ 'user.email'|trans }}</th>
                            <th>{{ 'user.first_name'|trans }}</th>
                            <th>{{ 'user.last_name'|trans }}</th>
                            <th>{{ 'user.job'|trans }}</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.sensitiveDataEmail }}</td>
                                <td>{{ user.sensitiveDataFirstName }}</td>
                                <td>{{ user.sensitiveDataName }}</td>
                                <td>{{ user.sensitiveDataJob }}</td>
                                <td>
                                    <div class="dropdown position-relative">
                                        <a href="#" style="color:black;" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                                            {% include 'components/feather_icons/more-horizontal.html.twig' %}
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            <a class="dropdown-item btn-edit" data-id="{{ user.id }}">
                                                <i class="fas fa-edit" style="color: #4169E1;"></i>
                                                {{ 'Edit'|trans }}
                                            </a>
                                            <a class="dropdown-item btn-delete" data-id="{{ user.id }}">
                                                <i class="fas fa-trash" style="color: #4169E1;"></i>
                                                {{ 'Remove'|trans }}
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# ================= PAGINATION ================= #}
            {% if users.pageCount > 1 %}
                <nav class="mt-3">
                    <ul class="pagination">
                        <li class="page-item {{ users.currentPageNumber == 1 ? 'disabled' : '' }}">
                            <a class="page-link"
                            href="?page={{ users.currentPageNumber - 1 }}">
                                {{ 'Previous'|trans }}
                            </a>
                        </li>

                        {% for page in 1..users.pageCount %}
                            <li class="page-item {{ users.currentPageNumber == page ? 'active' : '' }}">
                                <a class="page-link" href="?page={{ page }}">
                                    {{ page }}
                                </a>
                            </li>
                        {% endfor %}

                        <li class="page-item {{ users.currentPageNumber == users.pageCount ? 'disabled' : '' }}">
                            <a class="page-link"
                            href="?page={{ users.currentPageNumber + 1 }}">
                                {{ 'Next'|trans }}
                            </a>
                        </li>

                    </ul>
                </nav>
            {% endif %}
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('users') }}
{% endblock %}