<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}App{% endblock %}</title>

        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="Responsive App">
        <meta name="author" content="AKHAMAL ALAE-EDDINE">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <div class="wrapper">
            {% if app.user %} 
                {% include 'side-bar/index.html.twig' %} 
            {% endif %}
            <div class="main">
                {% include 'nav-bar/index.html.twig' %} 
                <main class="content">
                    <div class="container-fluid p-0">
                        {% if app.user %} 
                            {% include 'breadcrumb/breadcrumb.html.twig' %} 
                        {% endif %}
                        {% include 'flash_messages/flash_messages.html.twig' %}
                        {% block body %}{% endblock %}
                    </div>
                </main>
                {% include 'footer/index.html.twig' %}
            </div>
        </div>

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </body>
</html>
