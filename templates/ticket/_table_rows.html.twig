
{% set isManager = is_granted('ROLE_MANAGER') %}
{% set isAdmin = is_granted('ROLE_ADMIN') %}
<div class="table-responsive">
    <table class="table table-bordered border-primary table-hover table-striped">
        <thead class="table-primary">
            <tr>
                <th>{{ 'ticket.field.title'|trans }}</th>
                <th>{{ 'ticket.field.description'|trans }}</th>
                <th>{{ 'ticket.field.status'|trans }}</th>
                <th>{{ 'ticket.field.type'|trans }}</th>
                <th>{{ 'ticket.field.priority'|trans }}</th>
                <th>{{ 'ticket.field.created_by'|trans }}</th>
                {% if isManager or isAdmin %}
                    <th>{{ 'ticket.field.assigned_to'|trans }}</th>
                {% endif %}
                <th>{{ 'ticket.field.company'|trans }}</th>
                <th>{{ 'ticket.field.created_at'|trans }}</th>
                {% if isManager or isAdmin %}
                    <th>{{ 'ticket.field.resolved_at'|trans }}</th>
                    <th>{{ 'ticket.field.closed_at'|trans }}</th>
                {% endif %}
                <th>{{ 'Actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for ticket in tickets %}
                <tr>
                    <td>
                        {{ ticket.title|split(' ')|slice(0, 2)|join(' ') }}
                    </td>
                    <td>
                        {{ ticket.description|split(' ')|slice(0, 2)|join(' ') }}
                    </td>
                    <td>
                        {% if ticket.status.value == 'open' %}
                            <span class="badge rounded-pill bg-primary">{{ 'ticket.enum.open'|trans }}</span>
                        {% elseif ticket.status.value == 'in_progress' %}
                            <span class="badge rounded-pill bg-warning">{{ 'ticket.enum.in_progress'|trans }}</span>
                        {% elseif ticket.status.value == 'resolved' %}
                            <span class="badge rounded-pill bg-success">{{ 'ticket.enum.resolved'|trans }}</span>
                        {% elseif ticket.status.value == 'waiting_user' %}
                            <span class="badge rounded-pill bg-info">{{ 'ticket.enum.waiting_user'|trans }}</span>
                        {% elseif ticket.status.value == 'closed' %}
                            <span class="badge rounded-pill bg-danger">{{ 'ticket.enum.closed'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {{ ('ticket.enum.' ~ ticket.type.value)|trans|capitalize }}
                    </td>
                    <td>
                        {% if ticket.priority.value == 'low' %}
                            <span class="badge rounded-pill bg-success">{{ 'ticket.enum.low'|trans }}</span>
                        {% elseif ticket.priority.value == 'medium' %}
                            <span class="badge rounded-pill bg-primary">{{ 'ticket.enum.medium'|trans }}</span>
                        {% elseif ticket.priority.value == 'high' %}
                            <span class="badge rounded-pill bg-warning">{{ 'ticket.enum.high'|trans }}</span>
                        {% elseif ticket.priority.value == 'critical' %}
                            <span class="badge rounded-pill bg-danger">{{ 'ticket.enum.critical'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {{ ticket.createdBy and ticket.createdBy.Name ? ticket.createdBy.sensitiveDataFirstName ~ ' ' ~ ticket.createdBy.sensitiveDataName : '' }}
                    </td>
                    {% if isManager or isAdmin %}
                        <td>
                            {{ ticket.assignedTo and ticket.assignedTo.Name ?
                                ticket.assignedTo.sensitiveDataFirstName ~ ' ' ~  ticket.createdBy.sensitiveDataName : '' }}
                        </td>
                    {% endif %}
                    <td>{{ ticket.company ? ticket.company.name : '' }}</td>
                    <td>{{ ticket.createdAt|date('Y-m-d H:i') }}</td>
                    {% if isManager or isAdmin %}
                        <td>{{ ticket.resolvedAt ? ticket.resolvedAt|date('Y-m-d H:i') : '' }}</td>
                        <td>{{ ticket.closedAt ? ticket.closedAt|date('Y-m-d H:i') : '' }}</td>
                    {% endif %}
                    <td>
                        <div class="dropdown position-relative">
                            <a href="#" style="color:black;" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                                {% include 'components/feather_icons/more-horizontal.html.twig' %}
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item edit-ticket" data-id="{{ ticket.id }}">
                                    <i class="fas fa-edit" style="color: #4169E1;"></i>
                                    {{ 'Edit'|trans }}
                                </a>
                                {% if isManager or isAdmin %}
                                    <a class="dropdown-item remove-ticket" data-id="{{ ticket.id }}">
                                        <i class="fas fa-trash" style="color: #4169E1;"></i>
                                        {{ 'Remove'|trans }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="12">{{ 'no_tickets_found'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# Pagination #}
{% if pagination is defined %}
<div class="d-flex justify-content-center mt-3">
    <nav>
        <ul class="pagination">
            {# Previous #}
            <li class="page-item {{ pagination.hasPreviousPage ? '' : 'disabled' }}">
                <a class="page-link" href="#" data-page="{{ pagination.currentPage > 1 ? pagination.currentPage - 1 : 1 }}">
                    {{ 'Previous'|trans }}
                </a>
            </li>

            {# Pages #}
            {% for i in 1..pagination.totalPages %}
                <li class="page-item {{ i == pagination.currentPage ? 'active' : '' }}">
                    <a class="page-link" href="#" data-page="{{ i }}">{{ i }}</a>
                </li>
            {% endfor %}

            {# Next #}
            <li class="page-item {{ pagination.hasNextPage ? '' : 'disabled' }}">
                <a class="page-link" href="#" data-page="{{ pagination.currentPage < pagination.totalPages ? pagination.currentPage + 1 : pagination.totalPages }}">
                    {{ 'Next'|trans }}
                </a>
            </li>
        </ul>
    </nav>
</div>

{% endif %}