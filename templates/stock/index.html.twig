{% extends 'base.html.twig' %}

{% block title %}{{ 'stock.title'|trans }}{% endblock %}

{% block body %}

<div class="card" id="block-form-container" style="display:none;">
    <div class="card-header">
        <div class="flex-grow-1">
            <small class="float-end text-navy">
                <a id="hidden-stock-btn">
                    <i class="fas fa-remove" style="color: #4169E1; font-size:24px;"></i>
                </a>
            </small>
            <h5 class="card-title mb-0">
                {{ 'stock.form.title'|trans }}
            </h5>
        </div>
    </div>

    <div class="card-body">
        <div id="form-container"></div>
    </div>
</div>

<div class="card" id="block-equipment-list">
    <div class="card-header">
        <div class="flex-grow-1">
            <small class="float-end text-navy">
                <div class="card-actions float-end">
                    <div class="dropdown position-relative">
                        <a href="#" style="color:black;" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" class="">
                            {% include 'components/feather_icons/more-horizontal.html.twig' %}
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a class="dropdown-item" id="btn-add">
                                <i class="fas fa-plus" style="color: #4169E1;"></i>
                                {{ 'create_ticket'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            </small>
            <h5 class="card-title mb-0">
                {{ 'stock.title'|trans }}
            </h5>
        </div>
    </div>

    <div class="card-body">
        <div class="row g-3 table-responsive" >
            <input
                type="text"
                id="stock-search"
                placeholder={{ 'Search'|trans }}
                class="form-control mb-3"
            />
            <div class="table-responsive">
                <table class="table table-bordered border-primary table-hover table-striped">
                    <thead class="table-primary">
                        <tr>
                            <th>{{ 'ticket.field.company'|trans }}</th>
                            <th>{{ 'stock.form.fields.assignedTo'|trans }}</th>
                            <th>{{ 'ticket.field.equipments.reference'|trans }}</th>
                            <th>{{ 'ticket.field.equipments.N° Série'|trans }}</th>
                            <th>{{ 'stock.form.fields.assetTag'|trans }}</th>
                            <th>{{ 'ticket.field.equipments.status'|trans }}</th>
                            <th>{{ 'stock.form.fields.assetCondition'|trans }}</th>
                            <th>{{ 'stock.form.fields.location'|trans }}</th>
                            <th>{{ 'Actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody id="equipment-list">
                        {% include 'stock/_list.html.twig' %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('stock') }}
{% endblock %}