<form id="equipment-form"
      method="post"
      action="{{ path('admin_stock_form', {'id': equipment.id|default(null)}) }}">

    {{ form_row(form._token) }}

    <div class="d-flex align-items-start">

        {# ========================= #}
        {# NAV LEFT (TABS) #}
        {# ========================= #}
        <div class="nav flex-column nav-pills me-3"
             id="equipmentTabs"
             role="tablist"
             aria-orientation="vertical">

            <button class="nav-link active"
                    id="tab-identification"
                    data-bs-toggle="pill"
                    data-bs-target="#identification"
                    type="button"
                    role="tab">
                <i class="fas fa-tag" style="color:#4169E1;"></i>
                {{ 'stock.form.sections.identification'|trans }}
            </button>

            <button class="nav-link"
                    id="tab-status"
                    data-bs-toggle="pill"
                    data-bs-target="#status"
                    type="button"
                    role="tab">
                <i class="fas fa-clipboard-check" style="color:#28a745;"></i>
                {{ 'stock.form.sections.status'|trans }}
            </button>

            <button class="nav-link"
                    id="tab-assignment"
                    data-bs-toggle="pill"
                    data-bs-target="#assignment"
                    type="button"
                    role="tab">
                <i class="fas fa-user-check" style="color:#0d6efd;"></i>
                {{ 'stock.form.sections.assignment'|trans }}
            </button>

            <button class="nav-link"
                    id="tab-location"
                    data-bs-toggle="pill"
                    data-bs-target="#location"
                    type="button"
                    role="tab">
                <i class="fas fa-map-marker-alt" style="color:#dc3545;"></i>
                {{ 'stock.form.sections.location'|trans }}
            </button>

            <button class="nav-link"
                    id="tab-finance"
                    data-bs-toggle="pill"
                    data-bs-target="#finance"
                    type="button"
                    role="tab">
                <i class="fas fa-coins" style="color:#ffc107;"></i>
                {{ 'stock.form.sections.finance'|trans }}
            </button>

            <button class="nav-link"
                    id="tab-maintenance"
                    data-bs-toggle="pill"
                    data-bs-target="#maintenance"
                    type="button"
                    role="tab">
                <i class="fas fa-tools" style="color:#6c757d;"></i>
                {{ 'stock.form.sections.maintenance'|trans }}
            </button>

            <button class="nav-link"
                    id="tab-comment"
                    data-bs-toggle="pill"
                    data-bs-target="#comment"
                    type="button"
                    role="tab">
                <i class="fas fa-comment-dots" style="color:#6f42c1;"></i>
                {{ 'stock.form.sections.comment'|trans }}
            </button>

        </div>

        {# ========================= #}
        {# CONTENT RIGHT #}
        {# ========================= #}
        <div class="tab-content flex-grow-1 border p-3"
             id="equipmentTabsContent">

            {# IDENTIFICATION #}
            <div class="tab-pane fade show active" id="identification" role="tabpanel">
                {{ form_row(form.reference) }}
                {{ form_row(form.serialNumber) }}
                {{ form_row(form.assetTag) }}
                {{ form_row(form.company) }}
            </div>

            {# STATUS #}
            <div class="tab-pane fade" id="status" role="tabpanel">
                {{ form_row(form.status) }}
                {{ form_row(form.assetCondition) }}
            </div>

            {# ASSIGNMENT #}
            <div class="tab-pane fade" id="assignment" role="tabpanel">
                {{ form_row(form.assignedTo) }}
            </div>

            {# LOCATION #}
            <div class="tab-pane fade" id="location" role="tabpanel">
                {{ form_row(form.location) }}
                {{ form_row(form.storageLocation) }}
            </div>

            {# FINANCE #}
            <div class="tab-pane fade" id="finance" role="tabpanel">
                {{ form_row(form.purchaseDate) }}
                {{ form_row(form.purchasePrice) }}
                {{ form_row(form.supplier) }}
                {{ form_row(form.invoiceNumber) }}
            </div>

            {# MAINTENANCE #}
            <div class="tab-pane fade" id="maintenance" role="tabpanel">
                {{ form_row(form.warrantyEndDate) }}
                {{ form_row(form.lastMaintenanceAt) }}
                {{ form_row(form.maintenanceComment) }}
            </div>

            {# COMMENT #}
            <div class="tab-pane fade" id="comment" role="tabpanel">
                {{ form_row(form.comment) }}
            </div>

        </div>
    </div>

    <div class="mt-3 text-end">
        <button type="submit" class="btn btn-primary">
            {{ 'Save'|trans }}
        </button>
    </div>

</form>